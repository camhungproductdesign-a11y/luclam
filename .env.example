# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# ADMIN_TOKEN: Token quản trị cho POST /api/upload và POST /api/config.
# Sinh bằng: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Server sẽ từ chối khởi động nếu biến này trống.
ADMIN_TOKEN=

# HOST: Giao diện mạng server lắng nghe. Bỏ trống để dùng 127.0.0.1.
# Sau nginx thì để nguyên: 0.0.0.0 mở API ra thẳng internet, bỏ qua HTTPS,
# nghĩa là token quản trị đi trên mạng dạng thuần.
# Chỉ đặt 0.0.0.0 khi thật sự cần truy cập từ máy khác (container, LAN).
HOST=

# AEO_BRAND_SLUG: Slug của brand trên AEO, quyết định /blog lấy bài từ đâu.
# Server proxy /blog/* sang https://app.aeo.how/<slug>/blog/*.
# Bỏ trống để dùng brand thật của Lục Lam; chỉ đặt khi cần trỏ sang brand thử.
#
# Lưu ý: biến này không quyết định canonical. Canonical do AEO sinh từ custom
# domain khai trong Settings → Connections → Blog Domain. Chưa khai thì mọi bài
# viết vẫn trỏ canonical về app.aeo.how dù proxy chạy đúng, và toàn bộ giá trị
# SEO chảy về đó. `npm run smoke` bắt được trường hợp này.
AEO_BRAND_SLUG=

# PORT: Cổng server lắng nghe. Bỏ trống để dùng 3000.
# Nhiều nhà cung cấp tự cấp cổng qua biến này; giá trị đã export sẽ thắng .env.
# Server từ chối khởi động nếu đặt một giá trị không phải số nguyên 1–65535.
PORT=
